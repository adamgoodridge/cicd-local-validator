# Maps to spring.application.name
SPRING_APPLICATION_NAME=cicd-local-validator

# Maps to cicd.execution.local.workspace
# Must be an absolute host path shared with Docker Desktop.
# This same path is mounted into the app container and reused by nested Job containers.
LOCAL_WORKSPACE_PATH=/Users/your-user/repos

# Maps to custom.docker.command
# Set to podman to run all local container commands via Podman.
CUSTOM_DOCKER_COMMAND=docker

# Host socket path to mount into the container.
# Docker default: /var/run/docker.sock
# Podman rootless example: /run/user/1000/podman/podman.sock
CONTAINER_SOCKET_HOST_PATH=/var/run/docker.sock

# Socket path inside container; app uses this via DOCKER_HOST.
CONTAINER_SOCKET_CONTAINER_PATH=/var/run/docker.sock

# Maps to gitlab.api.url
GITLAB_API_URL=https://git.gitlab.net/api/v4

# Maps to gitlab.api.token
GITLAB_API_TOKEN=glpat-replace-me

